# ──────────────────────────────────────────────────────────────────────────
# Shared environment for the whole monorepo. Copy to .env and fill in.
#   server  (apps/server)      → ConfigModule envFilePath: ../../.env
#   prisma  (packages/database)→ loaded via dotenv-cli (../../.env)
#   client  (apps/client)      → loaded in next.config.mjs (../../.env)
# Anything prefixed NEXT_PUBLIC_ is exposed to the browser bundle.
# ──────────────────────────────────────────────────────────────────────────

# Postgres connection (server runtime + Prisma CLI). Keep this secret.
DATABASE_URL="postgresql://voguify:voguify@localhost:5432/voguify?schema=public"

# NestJS server port
PORT=4000

# Public base URL of the API, consumed by the Next.js client
NEXT_PUBLIC_API_URL="http://localhost:4000/api"

# ── Auth.js (NextAuth v5) — client sign-in ────────────────────────────────
# Session/token encryption secret. Generate with: openssl rand -base64 33
AUTH_SECRET=""

# Google OAuth credentials. Create a free OAuth client at
# https://console.cloud.google.com → APIs & Services → Credentials.
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Resend API key for magic-link emails (free tier at https://resend.com).
AUTH_RESEND_KEY=""
# From address for the sign-in email. For quick testing, onboarding@resend.dev
# works but only delivers to the email you signed up to Resend with.
AUTH_EMAIL_FROM="onboarding@resend.dev"
