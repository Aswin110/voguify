generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  highlights  String[] @default([])
  priceCents  Int      @default(0)
  premiumCents   Int?
  imageUrl    String?
  brand       String?
  styleNo     String?
  category    String?
  bestseller  Boolean  @default(false)
  sizes          Int?
  colors         Int?
  printProviders Int?
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
